#include <windows.h>
#include <commctrl.h>

#include "ayplayer.h"

IDD_AYPLAYER DIALOGEX DISCARDABLE 6,6,250,314
CAPTION "Fuse - AY Player"
STYLE WS_POPUP | WS_CAPTION | WS_VISIBLE | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  GROUPBOX "File", IDC_AY_FILE_GROUP, 7, 4, 236, 60
  LTEXT "File:", IDC_AY_FILE_LABEL, 14, 18, 38, 8
  EDITTEXT IDC_AY_FILE, 54, 16, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Author:", IDC_AY_AUTHOR_LABEL, 14, 32, 38, 8
  EDITTEXT IDC_AY_AUTHOR, 54, 30, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Misc:", IDC_AY_MISC_LABEL, 14, 46, 38, 8
  EDITTEXT IDC_AY_MISC, 54, 44, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP

  GROUPBOX "Song", IDC_AY_SONG_GROUP, 7, 68, 236, 98
  LTEXT "", IDC_AY_SONG, 14, 81, 222, 10, SS_ENDELLIPSIS | SS_NOPREFIX
  CONTROL "", IDC_AY_PROGRESS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 96, 230, 14
  LTEXT "", IDC_AY_ELAPSED, 14, 111, 110, 8
  RTEXT "", IDC_AY_LENGTH, 126, 111, 110, 8
  PUSHBUTTON "Pre&vious", IDC_AY_PREV, 14, 124, 42, 14
  DEFPUSHBUTTON "&Pause", IDC_AY_PAUSE, 59, 124, 42, 14
  PUSHBUTTON "S&top", IDC_AY_STOP, 104, 124, 42, 14
  PUSHBUTTON "&Next", IDC_AY_NEXT, 149, 124, 42, 14
  PUSHBUTTON "&List", IDC_AY_LIST, 194, 124, 42, 14
  LTEXT "Play:", IDC_AY_MODE_LABEL, 14, 148, 40, 8
  AUTORADIOBUTTON "&1 song", IDC_AY_MODE_SINGLE, 52, 147, 42, 10, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "&Whole list", IDC_AY_MODE_LIST, 96, 147, 58, 10
  AUTOCHECKBOX "&Repeat", IDC_AY_REPEAT, 156, 147, 64, 10, WS_GROUP | WS_TABSTOP

  GROUPBOX "Levels", IDC_AY_LEVEL_GROUP, 7, 170, 236, 56, WS_GROUP
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL1, 14, 183, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL1, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 182, 172, 11
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL2, 14, 197, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL2, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 196, 172, 11
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL3, 14, 211, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL3, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 210, 172, 11

  GROUPBOX "Sound", IDC_AY_SOUND_GROUP, 7, 230, 236, 48
  LTEXT "&Volume:", IDC_AY_VOLUME_LABEL, 14, 244, 40, 8
  CONTROL "", IDC_AY_VOLUME, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 52, 241, 152, 14
  RTEXT "", IDC_AY_VOLUME_TEXT, 206, 244, 30, 8
  LTEXT "Ste&reo:", IDC_AY_STEREO_LABEL, 14, 261, 40, 8
  COMBOBOX IDC_AY_STEREO, 56, 259, 70, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "Mi&xer...", IDC_AY_MIXER, 132, 258, 62, 14

  AUTOCHECKBOX "Load the mixer settings of the songs &automatically", IDC_AY_MIX_AUTO, 9, 283, 234, 10, WS_TABSTOP
  LTEXT "", IDC_AY_STATUS, 9, 299, 176, 8
  PUSHBUTTON "&Close", IDCLOSE, 189, 296, 54, 14
END

IDD_AYMIXER DIALOGEX DISCARDABLE 30,30,254,140
CAPTION "Fuse - AY Mixer"
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  LTEXT "Ste&reo:", IDC_AYM_STEREO_LABEL, 10, 12, 36, 8
  COMBOBOX IDC_AYM_STEREO, 48, 10, 70, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

  LTEXT "Place", IDC_AYM_PLACE_HEAD, 24, 34, 50, 8
  LTEXT "Volume", IDC_AYM_VOLUME_HEAD, 86, 34, 40, 8
  LTEXT "Panorama", IDC_AYM_PAN_HEAD, 170, 34, 40, 8
  LTEXT "", IDC_AYM_CHANNEL1, 10, 56, 10, 8
  COMBOBOX IDC_AYM_PLACE1, 22, 54, 56, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  RTEXT "", IDC_AYM_VOLUME_TEXT1, 126, 46, 34, 8
  CONTROL "", IDC_AYM_VOLUME1, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 82, 54, 80, 13
  RTEXT "", IDC_AYM_PAN_TEXT1, 210, 46, 34, 8
  CONTROL "", IDC_AYM_PAN1, "msctls_trackbar32", TBS_HORZ | TBS_BOTTOM | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 166, 53, 80, 15
  LTEXT "", IDC_AYM_CHANNEL2, 10, 78, 10, 8
  COMBOBOX IDC_AYM_PLACE2, 22, 76, 56, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  RTEXT "", IDC_AYM_VOLUME_TEXT2, 126, 68, 34, 8
  CONTROL "", IDC_AYM_VOLUME2, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 82, 76, 80, 13
  RTEXT "", IDC_AYM_PAN_TEXT2, 210, 68, 34, 8
  CONTROL "", IDC_AYM_PAN2, "msctls_trackbar32", TBS_HORZ | TBS_BOTTOM | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 166, 75, 80, 15
  LTEXT "", IDC_AYM_CHANNEL3, 10, 100, 10, 8
  COMBOBOX IDC_AYM_PLACE3, 22, 98, 56, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  RTEXT "", IDC_AYM_VOLUME_TEXT3, 126, 90, 34, 8
  CONTROL "", IDC_AYM_VOLUME3, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 82, 98, 80, 13
  RTEXT "", IDC_AYM_PAN_TEXT3, 210, 90, 34, 8
  CONTROL "", IDC_AYM_PAN3, "msctls_trackbar32", TBS_HORZ | TBS_BOTTOM | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 166, 97, 80, 15

  PUSHBUTTON "R&eset", IDC_AYM_RESET, 10, 120, 62, 14
  PUSHBUTTON "&Save...", IDC_AYM_SAVE, 96, 120, 62, 14
  PUSHBUTTON "&Close", IDCLOSE, 182, 120, 62, 14
END

IDD_AYPLAYLIST DIALOGEX DISCARDABLE 20,20,344,207
CAPTION "Fuse - AY Playlist"
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | DS_SETFONT
EXSTYLE WS_EX_ACCEPTFILES
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  CONTROL "", IDC_AYL_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 7, 7, 250, 179
  LTEXT "", IDC_AYL_STATUS, 7, 191, 250, 8, SS_ENDELLIPSIS
  PUSHBUTTON "&Add...", IDC_AYL_ADD, 263, 7, 74, 14
  PUSHBUTTON "Add &folder...", IDC_AYL_ADD_FOLDER, 263, 24, 74, 14
  PUSHBUTTON "&Remove", IDC_AYL_REMOVE, 263, 41, 74, 14
  PUSHBUTTON "C&lear list", IDC_AYL_CLEAR, 263, 58, 74, 14
  PUSHBUTTON "&Up", IDC_AYL_UP, 263, 78, 74, 14
  PUSHBUTTON "&Down", IDC_AYL_DOWN, 263, 95, 74, 14
  PUSHBUTTON "L&oad list...", IDC_AYL_LOAD, 263, 115, 74, 14
  PUSHBUTTON "&Save list...", IDC_AYL_SAVE, 263, 132, 74, 14
  PUSHBUTTON "&Measure lengths", IDC_AYL_MEASURE, 263, 152, 74, 14
  PUSHBUTTON "Measure a&gain", IDC_AYL_REMEASURE, 263, 169, 74, 14
  PUSHBUTTON "&Close", IDCLOSE, 263, 188, 74, 14
END

/* The TurboSound player: simpler, without level meters and sound settings
   (those go to its mixer), with the format of the music */
IDD_TSPLAYER DIALOGEX DISCARDABLE 6,6,250,231
CAPTION "Fuse - TurboSound Player"
STYLE WS_POPUP | WS_CAPTION | WS_VISIBLE | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  GROUPBOX "File", IDC_AY_FILE_GROUP, 7, 4, 236, 74
  LTEXT "File:", IDC_AY_FILE_LABEL, 14, 18, 38, 8
  EDITTEXT IDC_AY_FILE, 54, 16, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Author:", IDC_AY_AUTHOR_LABEL, 14, 32, 38, 8
  EDITTEXT IDC_AY_AUTHOR, 54, 30, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Format:", IDC_AY_FORMAT_LABEL, 14, 46, 38, 8
  EDITTEXT IDC_AY_FORMAT, 54, 44, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Misc:", IDC_AY_MISC_LABEL, 14, 60, 38, 8
  EDITTEXT IDC_AY_MISC, 54, 58, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP

  GROUPBOX "Song", IDC_AY_SONG_GROUP, 7, 82, 236, 115
  LTEXT "", IDC_AY_SONG, 14, 95, 222, 10, SS_ENDELLIPSIS | SS_NOPREFIX
  CONTROL "", IDC_AY_PROGRESS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 110, 230, 14
  LTEXT "", IDC_AY_ELAPSED, 14, 125, 110, 8
  RTEXT "", IDC_AY_LENGTH, 126, 125, 110, 8
  PUSHBUTTON "Pre&vious", IDC_AY_PREV, 14, 138, 54, 14
  DEFPUSHBUTTON "&Pause", IDC_AY_PAUSE, 70, 138, 54, 14
  PUSHBUTTON "S&top", IDC_AY_STOP, 126, 138, 54, 14
  PUSHBUTTON "&Next", IDC_AY_NEXT, 182, 138, 54, 14
  PUSHBUTTON "&List", IDC_AY_LIST, 14, 155, 110, 14
  PUSHBUTTON "Mi&xer...", IDC_AY_MIXER, 126, 155, 110, 14
  LTEXT "Play:", IDC_AY_MODE_LABEL, 14, 179, 40, 8
  AUTORADIOBUTTON "&1 song", IDC_AY_MODE_SINGLE, 52, 178, 42, 10, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "&Whole list", IDC_AY_MODE_LIST, 96, 178, 58, 10
  AUTOCHECKBOX "&Repeat", IDC_AY_REPEAT, 156, 178, 64, 10, WS_GROUP | WS_TABSTOP

  AUTOCHECKBOX "Load the mixer settings of the songs &automatically", IDC_AY_MIX_AUTO, 9, 201, 234, 10, WS_GROUP | WS_TABSTOP
  LTEXT "", IDC_AY_STATUS, 9, 216, 176, 8
  PUSHBUTTON "&Close", IDCLOSE, 189, 213, 54, 14
END

