/* The TurboSound mixer: the places and sizes are set by the code (in
   dialog units, as here), as are the controls of the nine channels */
IDD_TSMIXER DIALOGEX DISCARDABLE 30,30,444,202
CAPTION "Fuse - TurboSound Mixer"
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  PUSHBUTTON "&Load...", IDC_TSM_LOAD, 7, 7, 50, 14
  PUSHBUTTON "&Save...", IDC_TSM_SAVE, 61, 7, 50, 14
  PUSHBUTTON "R&eset", IDC_TSM_RESET, 115, 7, 50, 14
  LTEXT "Stereo &mode:", IDC_TSM_STEREO_LABEL, 189, 10, 48, 8
  COMBOBOX IDC_TSM_STEREO, 239, 8, 60, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  GROUPBOX "Master volume", IDC_TSM_MASTER_GROUP, 7, 26, 52, 156
  CONTROL "", IDC_TSM_MASTER, "msctls_trackbar32", TBS_VERT | TBS_AUTOTICKS | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 24, 70, 18, 96
  CTEXT "", IDC_TSM_MASTER_TEXT, 9, 168, 48, 8
  GROUPBOX "AY 1", IDC_TSM_GROUP1, 63, 26, 122, 156
  GROUPBOX "AY 2", IDC_TSM_GROUP2, 189, 26, 122, 156
  GROUPBOX "AY 3", IDC_TSM_GROUP3, 315, 26, 122, 156
  CONTROL "", IDC_TSM_LINE, "Static", SS_ETCHEDHORZ | WS_CHILD | WS_VISIBLE, 7, 187, 430, 1
  LTEXT "", IDC_TSM_STATUS, 7, 191, 430, 8, SS_ENDELLIPSIS | SS_NOPREFIX
END
