#include <windows.h>
#include <commctrl.h>

#include "ayplayer.h"

IDD_AYPLAYER DIALOGEX DISCARDABLE 6,6,250,312
CAPTION "Fuse - AY Player"
STYLE WS_POPUP | WS_CAPTION | WS_VISIBLE | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  GROUPBOX "File", IDC_AY_FILE_GROUP, 7, 4, 236, 60
  LTEXT "File:", IDC_AY_FILE_LABEL, 14, 18, 38, 8
  EDITTEXT IDC_AY_FILE, 54, 16, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Author:", IDC_AY_AUTHOR_LABEL, 14, 32, 38, 8
  EDITTEXT IDC_AY_AUTHOR, 54, 30, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Misc:", IDC_AY_MISC_LABEL, 14, 46, 38, 8
  EDITTEXT IDC_AY_MISC, 54, 44, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP

  GROUPBOX "Song", IDC_AY_SONG_GROUP, 7, 68, 236, 110
  LTEXT "&Song:", IDC_AY_SONG_LABEL, 14, 82, 38, 8
  COMBOBOX IDC_AY_SONG, 54, 80, 182, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  CONTROL "", IDC_AY_PROGRESS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 96, 230, 14
  LTEXT "", IDC_AY_ELAPSED, 14, 111, 110, 8
  RTEXT "", IDC_AY_LENGTH, 126, 111, 110, 8
  PUSHBUTTON "Pre&vious", IDC_AY_PREV, 14, 124, 52, 14
  DEFPUSHBUTTON "&Pause", IDC_AY_PAUSE, 70, 124, 52, 14
  PUSHBUTTON "S&top", IDC_AY_STOP, 126, 124, 52, 14
  PUSHBUTTON "&Next", IDC_AY_NEXT, 182, 124, 54, 14
  AUTOCHECKBOX "&Automatically go to the next song at the end", IDC_AY_AUTO, 14, 146, 222, 10, WS_TABSTOP
  AUTOCHECKBOX "&Repeat", IDC_AY_REPEAT, 14, 160, 222, 10, WS_TABSTOP

  GROUPBOX "Levels", IDC_AY_LEVEL_GROUP, 7, 182, 236, 56
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL1, 14, 195, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL1, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 194, 172, 11
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL2, 14, 209, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL2, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 208, 172, 11
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL3, 14, 223, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL3, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 222, 172, 11

  GROUPBOX "Sound", IDC_AY_SOUND_GROUP, 7, 242, 236, 48
  LTEXT "&Volume:", IDC_AY_VOLUME_LABEL, 14, 256, 40, 8
  CONTROL "", IDC_AY_VOLUME, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 52, 253, 152, 14
  RTEXT "", IDC_AY_VOLUME_TEXT, 206, 256, 30, 8
  LTEXT "Ste&reo:", IDC_AY_STEREO_LABEL, 14, 273, 40, 8
  COMBOBOX IDC_AY_STEREO, 56, 271, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

  LTEXT "", IDC_AY_STATUS, 9, 297, 176, 8
  PUSHBUTTON "&Close", IDCLOSE, 189, 294, 54, 14
END
