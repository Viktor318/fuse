#include <windows.h>
#include <commctrl.h>

#include "ayplayer.h"

IDD_AYPLAYER DIALOGEX DISCARDABLE 6,6,250,300
CAPTION "Fuse - AY Player"
STYLE WS_POPUP | WS_CAPTION | WS_VISIBLE | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  GROUPBOX "File", IDC_AY_FILE_GROUP, 7, 4, 236, 60
  LTEXT "File:", IDC_AY_FILE_LABEL, 14, 18, 38, 8
  EDITTEXT IDC_AY_FILE, 54, 16, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Author:", IDC_AY_AUTHOR_LABEL, 14, 32, 38, 8
  EDITTEXT IDC_AY_AUTHOR, 54, 30, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Misc:", IDC_AY_MISC_LABEL, 14, 46, 38, 8
  EDITTEXT IDC_AY_MISC, 54, 44, 182, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP

  GROUPBOX "Song", IDC_AY_SONG_GROUP, 7, 68, 236, 98
  LTEXT "", IDC_AY_SONG, 14, 81, 222, 10, SS_ENDELLIPSIS | SS_NOPREFIX
  CONTROL "", IDC_AY_PROGRESS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 96, 230, 14
  LTEXT "", IDC_AY_ELAPSED, 14, 111, 110, 8
  RTEXT "", IDC_AY_LENGTH, 126, 111, 110, 8
  PUSHBUTTON "Pre&vious", IDC_AY_PREV, 14, 124, 42, 14
  DEFPUSHBUTTON "&Pause", IDC_AY_PAUSE, 59, 124, 42, 14
  PUSHBUTTON "S&top", IDC_AY_STOP, 104, 124, 42, 14
  PUSHBUTTON "&Next", IDC_AY_NEXT, 149, 124, 42, 14
  PUSHBUTTON "&List", IDC_AY_LIST, 194, 124, 42, 14
  LTEXT "Play:", IDC_AY_MODE_LABEL, 14, 148, 40, 8
  AUTORADIOBUTTON "&1 song", IDC_AY_MODE_SINGLE, 52, 147, 42, 10, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "&Whole list", IDC_AY_MODE_LIST, 96, 147, 58, 10
  AUTOCHECKBOX "&Repeat", IDC_AY_REPEAT, 156, 147, 64, 10, WS_GROUP | WS_TABSTOP

  GROUPBOX "Levels", IDC_AY_LEVEL_GROUP, 7, 170, 236, 56, WS_GROUP
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL1, 14, 183, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL1, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 182, 172, 11
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL2, 14, 197, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL2, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 196, 172, 11
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL3, 14, 211, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL3, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 210, 172, 11

  GROUPBOX "Sound", IDC_AY_SOUND_GROUP, 7, 230, 236, 48
  LTEXT "&Volume:", IDC_AY_VOLUME_LABEL, 14, 244, 40, 8
  CONTROL "", IDC_AY_VOLUME, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 52, 241, 152, 14
  RTEXT "", IDC_AY_VOLUME_TEXT, 206, 244, 30, 8
  LTEXT "Ste&reo:", IDC_AY_STEREO_LABEL, 14, 261, 40, 8
  COMBOBOX IDC_AY_STEREO, 56, 259, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

  LTEXT "", IDC_AY_STATUS, 9, 285, 176, 8
  PUSHBUTTON "&Close", IDCLOSE, 189, 282, 54, 14
END

IDD_AYPLAYLIST DIALOGEX DISCARDABLE 20,20,380,190
CAPTION "Fuse - AY Playlist"
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | DS_SETFONT
EXSTYLE WS_EX_ACCEPTFILES
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  CONTROL "", IDC_AYL_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 7, 7, 286, 162
  LTEXT "", IDC_AYL_STATUS, 7, 174, 286, 8, SS_ENDELLIPSIS
  PUSHBUTTON "&Add...", IDC_AYL_ADD, 299, 7, 74, 14
  PUSHBUTTON "Add &folder...", IDC_AYL_ADD_FOLDER, 299, 24, 74, 14
  PUSHBUTTON "&Remove", IDC_AYL_REMOVE, 299, 41, 74, 14
  PUSHBUTTON "C&lear list", IDC_AYL_CLEAR, 299, 58, 74, 14
  PUSHBUTTON "&Up", IDC_AYL_UP, 299, 78, 74, 14
  PUSHBUTTON "&Down", IDC_AYL_DOWN, 299, 95, 74, 14
  PUSHBUTTON "L&oad list...", IDC_AYL_LOAD, 299, 115, 74, 14
  PUSHBUTTON "&Save list...", IDC_AYL_SAVE, 299, 132, 74, 14
  PUSHBUTTON "&Measure lengths", IDC_AYL_MEASURE, 299, 152, 74, 14
  PUSHBUTTON "&Close", IDCLOSE, 299, 171, 74, 14
END
