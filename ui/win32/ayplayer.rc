#include <windows.h>
#include <commctrl.h>

#include "ayplayer.h"

IDD_AYPLAYER DIALOGEX DISCARDABLE 6,6,262,316
CAPTION "Fuse - AY Player"
STYLE WS_POPUP | WS_CAPTION | WS_VISIBLE | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  GROUPBOX "File", IDC_AY_FILE_GROUP, 7, 4, 248, 60
  LTEXT "File:", IDC_AY_FILE_LABEL, 14, 18, 38, 8
  EDITTEXT IDC_AY_FILE, 54, 16, 194, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Author:", IDC_AY_AUTHOR_LABEL, 14, 32, 38, 8
  EDITTEXT IDC_AY_AUTHOR, 54, 30, 194, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
  LTEXT "Misc:", IDC_AY_MISC_LABEL, 14, 46, 38, 8
  EDITTEXT IDC_AY_MISC, 54, 44, 194, 12, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP

  GROUPBOX "Song", IDC_AY_SONG_GROUP, 7, 68, 248, 98
  LTEXT "", IDC_AY_SONG, 14, 81, 234, 10, SS_ENDELLIPSIS | SS_NOPREFIX
  CONTROL "", IDC_AY_PROGRESS, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 10, 96, 242, 14
  LTEXT "", IDC_AY_ELAPSED, 14, 111, 116, 8
  RTEXT "", IDC_AY_LENGTH, 132, 111, 116, 8
  PUSHBUTTON "Pre&vious", IDC_AY_PREV, 14, 124, 44, 14
  DEFPUSHBUTTON "&Pause", IDC_AY_PAUSE, 61, 124, 44, 14
  PUSHBUTTON "S&top", IDC_AY_STOP, 108, 124, 44, 14
  PUSHBUTTON "&Next", IDC_AY_NEXT, 155, 124, 44, 14
  PUSHBUTTON "&List", IDC_AY_LIST, 202, 124, 46, 14
  LTEXT "Play:", IDC_AY_MODE_LABEL, 14, 148, 40, 8
  AUTORADIOBUTTON "&1 song", IDC_AY_MODE_SINGLE, 52, 147, 42, 10, WS_GROUP | WS_TABSTOP
  AUTORADIOBUTTON "&Whole list", IDC_AY_MODE_LIST, 96, 147, 58, 10
  AUTOCHECKBOX "&Repeat", IDC_AY_REPEAT, 156, 147, 64, 10, WS_GROUP | WS_TABSTOP

  GROUPBOX "Levels", IDC_AY_LEVEL_GROUP, 7, 170, 248, 72, WS_GROUP
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL1, 14, 183, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL1, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 182, 120, 11
  CONTROL "", IDC_AY_CHANNEL_VOLUME1, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 186, 181, 62, 13
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL2, 14, 197, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL2, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 196, 120, 11
  CONTROL "", IDC_AY_CHANNEL_VOLUME2, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 186, 195, 62, 13
  AUTOCHECKBOX "", IDC_AY_LEVEL_LABEL3, 14, 211, 48, 10, WS_TABSTOP
  CONTROL "", IDC_AY_LEVEL3, "Static", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 64, 210, 120, 11
  CONTROL "", IDC_AY_CHANNEL_VOLUME3, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 186, 209, 62, 13
  PUSHBUTTON "R&eset", IDC_AY_CHANNEL_RESET, 186, 224, 62, 14

  GROUPBOX "Sound", IDC_AY_SOUND_GROUP, 7, 246, 248, 48
  LTEXT "&Volume:", IDC_AY_VOLUME_LABEL, 14, 260, 40, 8
  CONTROL "", IDC_AY_VOLUME, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 52, 257, 164, 14
  RTEXT "", IDC_AY_VOLUME_TEXT, 218, 260, 30, 8
  LTEXT "Ste&reo:", IDC_AY_STEREO_LABEL, 14, 277, 40, 8
  COMBOBOX IDC_AY_STEREO, 56, 275, 70, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

  LTEXT "", IDC_AY_STATUS, 9, 301, 188, 8
  PUSHBUTTON "&Close", IDCLOSE, 201, 298, 54, 14
END

IDD_AYPLAYLIST DIALOGEX DISCARDABLE 20,20,344,190
CAPTION "Fuse - AY Playlist"
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | DS_SETFONT
EXSTYLE WS_EX_ACCEPTFILES
FONT 8,"Ms Shell Dlg 2",400,0,1
BEGIN
  CONTROL "", IDC_AYL_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 7, 7, 250, 162
  LTEXT "", IDC_AYL_STATUS, 7, 174, 250, 8, SS_ENDELLIPSIS
  PUSHBUTTON "&Add...", IDC_AYL_ADD, 263, 7, 74, 14
  PUSHBUTTON "Add &folder...", IDC_AYL_ADD_FOLDER, 263, 24, 74, 14
  PUSHBUTTON "&Remove", IDC_AYL_REMOVE, 263, 41, 74, 14
  PUSHBUTTON "C&lear list", IDC_AYL_CLEAR, 263, 58, 74, 14
  PUSHBUTTON "&Up", IDC_AYL_UP, 263, 78, 74, 14
  PUSHBUTTON "&Down", IDC_AYL_DOWN, 263, 95, 74, 14
  PUSHBUTTON "L&oad list...", IDC_AYL_LOAD, 263, 115, 74, 14
  PUSHBUTTON "&Save list...", IDC_AYL_SAVE, 263, 132, 74, 14
  PUSHBUTTON "&Measure lengths", IDC_AYL_MEASURE, 263, 152, 74, 14
  PUSHBUTTON "&Close", IDCLOSE, 263, 171, 74, 14
END
