#include <windows.h>

#include "infobox.h"

IDD_INFOBOX DIALOGEX 0, 0, 250, 62
STYLE DS_3DLOOK | DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_CAPTION | WS_POPUP | WS_SYSMENU
CAPTION "Fuse - Info"
FONT 8,"Ms Shell Dlg 2",400,0,1
{
    ICON            "", IDC_INFOBOX_ICON, 10, 10, 21, 20
    LTEXT           "", IDC_INFOBOX_TEXT, 40, 12, 200, 20
    DEFPUSHBUTTON   "OK", IDOK, 100, 42, 50, 14
}
