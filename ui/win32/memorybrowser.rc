#include "memorybrowser.h"

IDD_MEM DIALOGEX DISCARDABLE 0,0,371,264
CAPTION "Fuse - Memory Browser"
FONT 8,"MS Sans Serif"
STYLE WS_POPUP | WS_CAPTION | WS_VISIBLE | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
BEGIN
  CONTROL	"", IDC_MEM_LV, "SysListView32", \
                WS_CHILD | WS_TABSTOP | WS_VISIBLE | LVS_REPORT | \
                LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSCROLL, \
                0,0,360,240, WS_EX_CLIENTEDGE
  SCROLLBAR     IDC_MEM_SB, 360,0,11,240, WS_CHILD | SBS_VERT
  LTEXT         "Double-click a byte or press Enter to change it.", IDC_MEM_HINT, 4,248,300,9
  PUSHBUTTON	"&Close", IDCLOSE, 315,245,51,14
END

IDD_MEM_EDIT DIALOGEX DISCARDABLE 0,0,170,80
CAPTION "Fuse - Edit Memory"
FONT 8,"MS Sans Serif"
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
BEGIN
  LTEXT         "Address:", -1, 7,9,40,8
  EDITTEXT      IDC_MEM_EDIT_ADDRESS, 52,7,60,13, ES_AUTOHSCROLL
  LTEXT         "Value:", -1, 7,27,40,8
  EDITTEXT      IDC_MEM_EDIT_VALUE, 52,25,60,13, ES_AUTOHSCROLL
  LTEXT         "Hexadecimal: $3A or 3Ah, decimal: 58", IDC_MEM_EDIT_HINT, 7,44,156,9
  DEFPUSHBUTTON "OK", IDOK, 59,59,50,14
  PUSHBUTTON    "Cancel", IDCANCEL, 113,59,50,14
END
